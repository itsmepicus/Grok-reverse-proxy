# Generate with: openssl rand -hex 32
GROK_PROXY_API_KEY=replace-with-a-long-random-value

# One or more comma-separated files/globs. Never copy these files into the repo.
GROK_AUTH_FILES=~/.grok/auth.json

# Runtime secrets are written with mode 0600 beneath this ignored directory.
GROK_STATE_FILE=./data/accounts.json

GROK_LISTEN_ADDR=127.0.0.1:8080
GROK_UPSTREAM_URL=https://cli-chat-proxy.grok.com
GROK_TOKEN_URL=https://auth.x.ai/oauth2/token
# Optional override; leave unset to use the proxy's built-in client ID.
# GROK_OAUTH_CLIENT_ID=replace-with-your-oauth-client-id
GROK_CLIENT_VERSION=0.2.93
GROK_REFRESH_LEAD=10m
GROK_REQUEST_TIMEOUT=120s
GROK_MAX_BODY_BYTES=8388608
GROK_MAX_CONCURRENCY_PER_ACCOUNT=1

# Optional HTTP(S) egress proxy. Credentials remain in your local .env.
# GROK_EGRESS_PROXY=http://127.0.0.1:3128

# Only needed for local integration tests with an http:// mock upstream.
# GROK_ALLOW_INSECURE_UPSTREAM=false

# Sends OAuth credentials to non-x.ai/non-grok.com hosts. Leave false unless
# you deliberately operate and trust a custom upstream.
# GROK_ALLOW_CUSTOM_ENDPOINTS=false
